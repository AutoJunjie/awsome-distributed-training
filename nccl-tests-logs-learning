###       NCCL_BUFFSIZE=8388608 (8MB)      — 比 NCCL 默认 4MB 大，吃满 EFA pipe
###       NCCL_NET_FORCE_FLUSH=0           — 不强制 flush，靠 RDMA 内置 fence
###       NCCL_NVLS_CHUNKSIZE=524288       — NVLS chunk 调到 512KB
###       NCCL_NVLSTREE_MAX_CHUNKSIZE=512K
###       NCCL_P2P_NET_CHUNKSIZE=512K      — 跨节点 P2P chunk
###       NCCL_TOPO_FILE=/proc/self/fd/145 — 注入合成的 AWS topology XML
###       NCCL_TUNER_PLUGIN=libnccl-net.so — 让 NCCL 把 tuner 也加载这个 .so
